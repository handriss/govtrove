# Neon Database URL (for running against Neon)
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/govtrove?sslmode=require

# SAM.gov API Key
SAM_API_KEY=your-sam-api-key

# Tawk.to live chat widget (property ID from embed code, e.g. XXXXXXXX/YYYYYYYY)
VITE_TAWK_PROPERTY_ID=69a7180d7b02b21c3601dced/1jiqbbtmn

RESEND_API_KEY=resend-api-key
RESEND_FROM_EMAIL=notifications@govtrove.com
RESEND_WEBHOOK_SECRET=resend-webhook-signing-secret

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_MONTHLY=price_...

# Posthog
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# ── Content pipeline (weekly blog automation) ──────────────────────────────
# Google Search Console: service-account JSON key path (store OUTSIDE the repo)
GSC_CREDENTIALS_PATH=~/.config/govtrove/gsc-key.json
GSC_PROPERTY=sc-domain:govtrove.com
# IndexNow (OPTIONAL/deferred — mainly pings Bing/Yandex): random hex key,
# also served at https://govtrove.com/<key>.txt
INDEXNOW_KEY=
# Telegram review bot: token from @BotFather, chat id from getUpdates after messaging the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# PostHog PERSONAL API key (us.posthog.com, project 334808) — distinct from the phc_ project key above
POSTHOG_API_KEY=phx_...
POSTHOG_PROJECT_ID=334808
POSTHOG_HOST_APP=https://us.posthog.com
# Internal emails/IPs to exclude from analytics (comma-separated; email supports @domain suffix)
INTERNAL_EMAILS=
INTERNAL_IPS=
# Neon demand signals are read directly via NEON_DATABASE_URL (top of file) —
# the pipeline runs locally in a Claude Code session, so no internal HTTP API is needed.