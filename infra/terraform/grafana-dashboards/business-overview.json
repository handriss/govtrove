{
  "title": "GovTrove Business Overview",
  "uid": "govtrove-business",
  "timezone": "utc",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Search Volume (trailing 7-day)",
      "description": "At each hour, the total number of searches in the preceding 7 days",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  h.time,\n  (SELECT COUNT(*) FROM search_events\n   WHERE event_type = 'search'\n     AND created_at > h.time - INTERVAL '7 days'\n     AND created_at <= h.time) AS \"7-Day Searches\"\nFROM generate_series(\n  $__timeFrom()::timestamptz,\n  $__timeTo()::timestamptz,\n  '1 hour'::interval\n) AS h(time)\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Registered Users",
      "description": "Cumulative number of registered users over time",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": {
        "type": "postgres",
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "rawSql": "SELECT\n  h.time,\n  (SELECT COUNT(*) FROM users WHERE created_at <= h.time) AS \"Total Users\"\nFROM generate_series(\n  $__timeFrom()::timestamptz,\n  $__timeTo()::timestamptz,\n  '1 hour'::interval\n) AS h(time)\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
